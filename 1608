class Solution {
    public int specialArray(int[] nums) {
        Arrays.sort(nums);
        int start = 0;
        int end = nums.length -1;
        while(start<=end){
            int mid = start +(end - start)/2;
            int count  = nums.length-mid;
            if(nums[mid] >=  count){
                  if(mid == 0 || nums[mid-1] < count)
                  {return count;}
                  else{
                    end= mid - 1;
                  }
            }
            else{
                start = mid + 1;
            }
        }
        return -1;
    }
}
