class Solution {
    public boolean checkIfExist(int[] arr) {
        int end = arr.length - 1;
        int start = 0;
        for(int i = 0 ; i <= end ; i++){
            for(int j = 0 ; j <=end ; j++){
                if(i!=j){
                    if(arr[i] == 2*arr[j]){
                    return true;
                }
                }
            }
        }
        return false;
    }
}
