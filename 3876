class Solution {
    public boolean uniformArray(int[] nums1) {
        int mineven = Integer.MAX_VALUE;
        int minodd = Integer.MAX_VALUE;
        
        for (int num : nums1) {
    
            if (num % 2 == 0) {
                if (num < mineven) {
                    mineven = num;
                }
            } else {
                if (num < minodd) {
                    minodd = num;
                }
            }
        }
        
        if (mineven == Integer.MAX_VALUE || minodd == Integer.MAX_VALUE) {
            return true;
        }
        
        return mineven > minodd;
    }
}
