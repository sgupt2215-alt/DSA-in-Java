class Solution {
    public int splitArray(int[] nums, int k) {
        int low =0;
        int high = 0;
        int ans = 0;
        // low in minimum no of student that i can distribute the books to and high is maximum no student 
        for (int num : nums) {
            low = Math.max(low, num);
            high += num; 
        }
        while(low <= high){
            int mid = low +(high - low)/2;
            if(test(nums,k,mid)){
                ans = mid;
                high = mid - 1;
            }
            else{
                low = mid +1;
            }
        }
          return ans;
    }
    public boolean test(int[] nums , int k , int mid){
        int temp = 1 ;
        int current = 0;
        for(int num : nums){
            if(num > mid ) return false;
            if(current + num > mid){
                current = num;
                temp++ ;
            }
            else{
                current += num;
            }
        }
        return temp<=k;
    }
}
