class Solution {
    public int firstStableIndex(int[] nums, int k) {
        if (nums == null || nums.length == 0) {
            return -1;
        }
        
        int n = nums.length;
        int[] suffMin = new int[n];
        suffMin[n - 1] = nums[n - 1];
        
        for (int i = n - 2; i >= 0; i--) {
            suffMin[i] = Math.min(nums[i], suffMin[i + 1]);
        }
        
        int num1 = nums[0];
        
        for (int i = 0; i < n; i++) {
            if (nums[i] > num1) {
                num1 = nums[i];
            }
            
            int num2 = suffMin[i];
            int temp = num1 - num2;
            
            if (temp <= k) {
                return i;
            }
        }
        
        return -1;
    }
}
