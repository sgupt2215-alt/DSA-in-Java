class Solution {
    public boolean searchMatrix(int[][] matrix, int target) {
        //binary search to find the target row
        int s = 0;
        int e = matrix.length -1 ;
        if(matrix[0][0] > target){
            return false;
        }
        else{
        
        while(s <= e){
            int mid = s + (e - s)/2;
            if(matrix[mid][0] < target){
                s = mid+1;
            }
            else if(matrix[mid][0] > target) {
                e = mid -1;
            }
            else{
                return true;
            }
        }
    }
        //binary search to find element
        int start = 0;
        int end = matrix[e].length -1;
       while(start <= end){
        int com = start + (end -start)/2;
        if(matrix[e][com] == target){
            return true;
        }
        else if (matrix[e][com] > target){
            end = com - 1;
        }
        else{
            start = com + 1;
        }
       }
       return false;
    }
}
