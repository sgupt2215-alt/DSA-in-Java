

class Solution {
    public int minAbsoluteSumDiff(int[] nums1, int[] nums2) {
        int MOD = 1_000_000_007;
        int n = nums1.length;
        
      
        int[] sorted1 = nums1.clone();
        Arrays.sort(sorted1);
        
        long totalSum = 0;
        long maxDecrease = 0;
    
        for (int i = 0; i < n; i++) {
            long diff = Math.abs(nums1[i] - nums2[i]);
            totalSum += diff;
            
            
            if (diff == 0) continue;
            
           
            int idx = Arrays.binarySearch(sorted1, nums2[i]);
            
            if (idx >= 0) {
                
                maxDecrease = Math.max(maxDecrease, diff);
            } else {
            
                int insertPos = -(idx + 1);
                
              
                if (insertPos < n) {
                    long newDiff = Math.abs(sorted1[insertPos] - nums2[i]);
                    maxDecrease = Math.max(maxDecrease, diff - newDiff);
                }
                
               
                if (insertPos > 0) {
                    long newDiff = Math.abs(sorted1[insertPos - 1] - nums2[i]);
                    maxDecrease = Math.max(maxDecrease, diff - newDiff);
                }
            }
        }
        
        
        return (int) ((totalSum - maxDecrease) % MOD);
    }
}
